# ==============================================================================
# BrandShield AI Backend Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Application Environment (dev, prod, test)
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# Supabase Database & Auth Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Model Provider Credentials
# At least one key is recommended for LLM analysis and vector embeddings
OPENAI_API_KEY=sk-proj-your-openai-api-key
GEMINI_API_KEY=AIzaSy-your-gemini-api-key

# File Upload Limits
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,png,jpg,jpeg,webp

# CORS Whitelist (comma-separated origins or *)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
